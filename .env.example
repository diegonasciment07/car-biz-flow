# Variáveis de ambiente do projeto (exemplo)
# Copie este arquivo para .env e preencha os valores reais no Lovable Cloud.
# NUNCA comite o arquivo .env real no GitHub.

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=seu-projeto-id

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=seu-projeto-id

# Apenas no backend (não expor no frontend)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Senha compartilhada do painel interno de leads (/painel) - gere uma senha forte
# PAINEL_PASSWORD=

# Chave interna de criptografia da sessão do painel (nunca digitada por humano)
# gere com: openssl rand -base64 48
# PAINEL_SESSION_SECRET=
